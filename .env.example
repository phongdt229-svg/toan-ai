APP_NAME="TOAN AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Production: LOG_STACK=daily để xoay vòng log theo ngày, giữ LOG_DAILY_DAYS ngày
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=toan_ai
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Asia/Ho_Chi_Minh

# ---- AI provider (Phase 7) ----
AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- MoMo (Phase 9) ----
# momo | fake (giả lập thanh toán ở local, bị chặn ở production)
PAYMENT_GATEWAY=momo
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_IPN_URL="${APP_URL}/api/v1/payment/momo/ipn"
MOMO_RETURN_URL="${APP_URL}/payment/momo/return"

# Chỉ đặt khi chạy sau reverse proxy / load balancer (vd: TRUSTED_PROXIES=* hoặc danh sách IP)
TRUSTED_PROXIES=

# Sao lưu DB (php artisan backup:database — tự chạy 02:00 ở production)
BACKUP_MYSQLDUMP_PATH=mysqldump
BACKUP_KEEP_DAYS=14

# Giám sát lỗi production (Sentry). Để trống = tắt. Không bật send_default_pii: đây là dữ liệu của trẻ em.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_SEND_DEFAULT_PII=false

# Bắt buộc quản trị viên bật xác thực 2 bước (bật sau khi mọi admin đã cài xong).
ADMIN_REQUIRE_2FA=false

# Số liệu Google Analytics ngay trong Quản trị (GA4 Data API). Để trống = ẩn phần này.
# GA_PROPERTY_ID là số (GA4 → Quản trị → Chi tiết tài sản), KHÔNG phải G-XXXX.
# GA_CREDENTIALS_PATH trỏ tới file JSON của service account (thêm nó vào GA4 với quyền Người xem) — để ngoài repo.
GA_PROPERTY_ID=
GA_CREDENTIALS_PATH=

# Nút chat nổi (Zalo/Messenger) — khác hàng icon mạng xã hội ở chân trang bên dưới.
SITE_ZALO_URL=
SITE_FACEBOOK_URL=

# Hàng biểu tượng mạng xã hội ở CHÂN TRANG. Link nào để trống thì icon đó tự ẩn — không dán
# link giả kiểu facebook.com/x, SocialLink sẽ lọc bỏ nhưng tốt nhất là đừng đặt link chưa có thật.
SITE_SOCIAL_FACEBOOK=
SITE_SOCIAL_YOUTUBE=
SITE_SOCIAL_TIKTOK=
SITE_SOCIAL_X=
SITE_SOCIAL_GOOGLE=
